# ─────────────────────────────────────────────
#  Material Theory Agent — Environment Config
# ─────────────────────────────────────────────

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# LangSmith tracing (required for observability)
# Get yours at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=material-theory-agent

# Model config (defaults shown)
GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2

# Agent config
MAX_REFINEMENT_ITERATIONS=5
