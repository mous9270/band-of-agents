# Band agent credentials — one named block per agent.
# Copy to agent_config.yaml and fill in. Read back with
# thenvoi.config.load_agent_config("procurement").
# Create the agent as an *external agent* on the Band platform first, then paste
# its agent_id + api_key here. This file holds live keys: it is gitignored.
procurement:
  agent_id: "<your-procurement-agent-id>"
  api_key: "<your-procurement-api-key>"

# Handles of every agent in the pipeline, used for autonomous handoff between
# agents (so the human only sends the initial task). Mentions must use exact
# handles: @<username> for people, @<username>/<agent-name> for agents.
# `requester` is the human who starts the pipeline (final results go to them).
pipeline:
  requester: "@<username>"
  material_theory: "@<username>/material-theory-agent"
  virtual_lab: "@<username>/virtual-lab-agent"
  procurement: "@<username>/the-procurement-sourcing"
